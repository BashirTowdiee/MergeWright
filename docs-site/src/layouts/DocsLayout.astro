---
import '../styles/global.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface DocNavItem {
  id: string;
  data: {
    title?: string;
    description?: string;
  };
}

interface Props {
  currentDoc: DocNavItem;
  docs: DocNavItem[];
  headings: Heading[];
}

const { currentDoc, docs, headings } = Astro.props;

function routeForDocId(id: string): string {
  return `/docs/${id}`;
}

function titleFromId(id: string): string {
  const file = id.split('/').pop() ?? id;
  return file
    .replace(/\.md$/, '')
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());
}

function groupFromId(id: string): string {
  const parts = id.split('/');
  if (parts.length === 1) return 'root';
  return parts[0] ?? 'root';
}

const grouped = new Map<string, DocNavItem[]>();
for (const doc of docs) {
  const group = groupFromId(doc.id);
  const current = grouped.get(group) ?? [];
  current.push(doc);
  grouped.set(group, current);
}

const sortedGroups = [...grouped.entries()].sort((a, b) => a[0].localeCompare(b[0]));
for (const [, items] of sortedGroups) {
  items.sort((a, b) => a.id.localeCompare(b.id));
}

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const currentTitle = currentDoc.data.title ?? titleFromId(currentDoc.id);
const currentDescription = currentDoc.data.description ?? '';
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{currentTitle} | MergeWright Docs</title>
    <meta name="description" content={currentDescription} />
  </head>
  <body>
    <header class="topbar">
      <a href="/" class="brand">MergeWright Docs</a>
    </header>
    <div class="docs-shell">
      <aside class="left-nav">
        <nav aria-label="Documentation navigation">
          <h2>Documentation</h2>
          {sortedGroups.map(([group, items]) => (
            <section class="nav-section" aria-labelledby={`nav-${group}`}>
              <h3 id={`nav-${group}`}>{group}</h3>
              <ul>
                {items.map((doc) => (
                  <li>
                    <a
                      href={routeForDocId(doc.id)}
                      class={doc.id === currentDoc.id ? 'active' : ''}
                      aria-current={doc.id === currentDoc.id ? 'page' : undefined}
                    >
                      <span>{doc.data.title ?? titleFromId(doc.id)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>
      </aside>

      <main class="doc-main">
        <header class="doc-header">
          <h1>{currentTitle}</h1>
          {currentDescription && <p>{currentDescription}</p>}
        </header>
        <slot />
      </main>

      <aside class="right-toc">
        <nav aria-label="Table of contents">
          <h2>On this page</h2>
          {toc.length > 0 ? (
            <ul>
              {toc.map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p>No headings available.</p>
          )}
        </nav>
      </aside>
    </div>
  </body>
</html>
