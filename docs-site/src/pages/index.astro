---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const docs = await getCollection('docs');

function titleFromId(id: string): string {
  const file = id.split('/').pop() ?? id;
  return file
    .replace(/\.md$/, '')
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

function groupFromId(id: string): string {
  const parts = id.split('/');
  if (parts.length === 1) return 'root';
  return parts[0] ?? 'root';
}

const grouped = new Map<string, typeof docs>();
for (const doc of docs.sort((a, b) => a.id.localeCompare(b.id))) {
  const group = groupFromId(doc.id);
  const current = grouped.get(group) ?? [];
  current.push(doc);
  grouped.set(group, current);
}

const groups = [...grouped.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shepherds-Staff Docs</title>
  </head>
  <body>
    <main class="landing">
      <header class="hero">
        <p class="eyebrow">Documentation</p>
        <h1>Shepherds-Staff Docs</h1>
        <p>Product documentation for workflows, commands, safety, providers, reports, configuration, examples, and architecture.</p>
      </header>

      {groups.map(([group, items]) => (
        <section class="doc-category">
          <header class="category-header">
            <h2>{group}</h2>
          </header>
          <div class="cards">
            {items.map((doc) => (
              <a class="card" href={`/docs/${doc.id}`}>
                <h3>{doc.data.title ?? titleFromId(doc.id)}</h3>
                <p>{doc.id}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>
