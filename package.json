{
  "name": "mergewright",
  "version": "0.1.0",
  "private": true,
  "description": "AI software delivery harness for reviewable, auditable, merge-ready code changes.",
  "type": "module",
  "bin": {
    "mergewright": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "agent": "npm run mergewright --",
    "mergewright": "npm run build && node dist/src/cli.js",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run preview",
    "docs:check": "npm --prefix docs-site run check"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ink": "^7.0.3",
    "react": "^19.2.6"
  }
}
